# ===================================================
# FeedbackHub Backend Environment Configuration
# Copy this file to .env and configure your secrets.
# NEVER commit actual passwords or keys to git.
# ===================================================

# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/feedbackhub?retryWrites=true&w=majority

# Optional: Dedicated Test Database URI for running real MongoDB integration tests
# TEST_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/feedbackhub_test?retryWrites=true&w=majority

# Security & Authentication
# In production, JWT_SECRET must be at least 32 characters long and cannot be a placeholder.
# Generate a secure 32+ character random hex string using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_SECURE_SECRET_WITH_CRYPTO_RANDOMBYTES_32

# Development & Demo Controls
# Set to 'false' in production. When 'true' (dev only), allows fast demo logins for testing.
ENABLE_DEMO_MODE=false

# DNS Resolver Configuration
# Default is false (uses OS system DNS). Set to 'true' ONLY in local development
# if your local router / ISP blocks MongoDB Atlas SRV lookups (querySrv ECONNREFUSED).
# Note: Fallback DNS is strictly forbidden and ignored when NODE_ENV=production.
ENABLE_FALLBACK_DNS=false

